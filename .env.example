# ── Surface (Part A) ──────────────────────────────────────
# Which product surface this deployment is. One codebase, two Vercel projects.
#   mobile  the store binary — coins everywhere, CASH on SPORTS only.
#           Cash entertainment is OMITTED from the API payload server-side.
#   web     lockin.llc — every category, cash included.
# Unset defaults to "mobile" (the tighter policy), so an existing deployment
# keeps its current behaviour without needing this set.
NEXT_PUBLIC_SURFACE=mobile

# ── Firebase (web SDK — safe to expose) ───────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (service account — server only, keep secret) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full private key in quotes; literal \n are converted at runtime.
FIREBASE_PRIVATE_KEY=

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
# Recurring Price ID for the $9.99/mo user Pro plan
STRIPE_PRO_PRICE_ID=

# ── Anthropic (AI agent) ──────────────────────────────────
ANTHROPIC_API_KEY=

# ── KYC (identity verification) ───────────────────────────
# Provider select: mock | stripe. Unset → stripe when its keys exist, else mock
# (so local dev fails closed to practice instead of crashing).
KYC_PROVIDER=mock
# Stripe Identity webhook signing secret — a SEPARATE endpoint (/api/webhooks/kyc)
# from the payments webhook. Get it from the Stripe dashboard for that endpoint.
STRIPE_IDENTITY_WEBHOOK_SECRET=
# Mock provider webhook HMAC secret (local/dev/test only; never used in prod).
KYC_MOCK_WEBHOOK_SECRET=

# ── MaxMind GeoIP2 (geo-fencing) ──────────────────────────
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bearer secret for the admin settlement endpoint (/api/admin/settle)
ADMIN_SETTLE_SECRET=
# Bearer secret for the auto-settlement cron (/api/cron/settle). Vercel Cron
# sends this automatically when set; also used by external schedulers.
CRON_SECRET=

# Comma-separated Firebase uids allowed into the admin pages (/admin/creators).
ADMIN_UIDS=

# Optional: real bookmaker odds for the data feed (the-odds-api.com free tier). Absent = ESPN odds only.
THE_ODDS_API_KEY=
