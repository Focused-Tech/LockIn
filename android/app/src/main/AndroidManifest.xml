<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links: lockin://slate/<slateId> opens the app to that slate
                 (and lockin://<path> generally). BROWSABLE lets a browser/IG link
                 launch it; DEFAULT lets an implicit VIEW intent resolve here.
                 Capacitor's App plugin delivers the URL to the JS appUrlOpen
                 listener (see src/lib/notifications/native.ts). -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lockin" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- RECORD_AUDIO: powers the Locksmith microphone (speech-to-text) so a player can ask the
         guide a question by voice instead of typing. Requested at the moment the user taps the mic;
         never recorded or stored beyond the live transcription. NOTE: the in-WebView Web Speech API
         is currently disabled (no native STT bridge yet) — this permission is declared ahead of that
         wiring. If STT does not ship, remove this line to avoid an unused-permission review flag. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
</manifest>
