<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent icon for the Android 12+ system splash. We do NOT want the app launcher icon
     appearing in the splash sequence; the branded splash.png is shown by the Capacitor plugin. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
