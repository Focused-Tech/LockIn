# RELEASE SIGNING — TEMPLATE ONLY. Copy to `android/keystore.properties` and fill in.
# The real file is git-ignored and must NEVER be committed. Do not put real values here.
#
# 1. Create a keystore (once, keep it safe + backed up — losing it means you can never update
#    the app on Play under the same identity):
#      keytool -genkey -v -keystore lockin-release.jks -keyalg RSA -keysize 2048 \
#        -validity 10000 -alias lockin
# 2. Copy this file to android/keystore.properties and set the four values below.
# 3. Build the signed bundle:  cd android && ./gradlew bundleRelease
#
# storeFile may be absolute or relative to the android/ directory.
storeFile=/absolute/path/to/lockin-release.jks
storePassword=CHANGEME
keyAlias=lockin
keyPassword=CHANGEME

# CI alternative (no file): set these environment variables instead —
#   LOCKIN_KEYSTORE_FILE, LOCKIN_KEYSTORE_PASSWORD, LOCKIN_KEY_ALIAS, LOCKIN_KEY_PASSWORD
